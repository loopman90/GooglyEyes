{
  "name": "googly-eyes",
  "version": "1.0.5",
  "description": "Put living reactive eyes in your workspace.",
  "main": "main.js",
  "scripts": {
    "update-readme": "node scripts/update-readme.mjs",
    "prebuild": "node scripts/update-readme.mjs",
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "prepackage-test": "node scripts/update-readme.mjs",
    "package-test": "node scripts/package-test.mjs",
    "version:check": "node scripts/check-version.mjs",
    "validate-assets": "node scripts/validate-assets.mjs",
    "release:check": "npm run version:check && npm run validate-assets && npm run build && node scripts/release-check.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "googly-eyes",
    "companion"
  ],
  "author": "GooglyEyes",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.6.0"
  }
}
